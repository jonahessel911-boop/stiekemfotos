# xAI — https://console.x.ai — never commit real keys
# Eén key voor alles: Grok chat, spraak→tekst (STT), TTS. Zet de waarde na = op één regel.
# (Fallbacks voor oude setups: GROK_API_KEY of XAI_KEY — liever alleen XAI_API_KEY.)
XAI_API_KEY=
# GROK_API_KEY=

# Chat-model zonder foto (zie “Models” in de console voor jouw account)
# XAI_MODEL=grok-3-latest

# Verplicht voor foto’s in de chat: een model dat image input ondersteunt.
# Exacte naam in console (veel accounts: grok-4 of grok-4.3).
# XAI_VISION_MODEL=grok-4

# Sessies voor inloggen (min. 16 tekens in productie)
# SESSION_SECRET=

# Optional: TTS voice id (default eve — jong/energiek; ara/sal ook mogelijk)
# XAI_TTS_VOICE=eve

# Optional: STT taal (default "nl") — wordt naar xAI /v1/stt gestuurd als `language`.
# XAI_STT_LANGUAGE=nl

# Z-Image Turbo API key (server-side only, never expose client-side).
ZMODEL_API_KEY=
# Optional API base override (default: https://zimageturbo.ai)
# ZMODEL_BASE_URL=https://zimageturbo.ai

# Optional: protect AI settings page (leave empty to disable in dev)
INSTELLINGEN_PIN=

# --- Supabase (profiles + persistent storage) ---
# Lokaal: vul `.env.local`. Live (Vercel): **dezelfde namen en waarden** als lokaal,
# in Project Settings → Environment Variables → Production (en Preview als je die gebruikt).
# Na het toevoegen/wijzigen van secrets: opnieuw deployen zodat serverless een nieuwe bundle krijgt.
#
# Minimaal nodig op de server (profielenlijst, API routes):
#   - Project-URL: `SUPABASE_URL` en/of `NEXT_PUBLIC_SUPABASE_URL` (zelfde Supabase-project als lokaal).
#   - Minstens één key waarmee `profiles` gelezen mag worden:
#       • `SUPABASE_SERVICE_ROLE_KEY` — aanbevolen op productie (RLS omzeilen voor server-side reads).
#       • en/of anon: `SUPABASE_ANON_KEY` / `NEXT_PUBLIC_SUPABASE_ANON_KEY` (alleen als RLS dat toestaat).
#
# Als live geen profielen toont maar lokaal wel: controleer Vercel-env (typfout, verkeerd project,
# vergeten `SUPABASE_SERVICE_ROLE_KEY`) en Supabase RLS voor `SELECT` op `profiles`.
#
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for protected engagement cron endpoint:
# Vercel cron should call /api/internal/engagement/dispatch with:
# Authorization: Bearer <ENGAGEMENT_CRON_SECRET>
ENGAGEMENT_CRON_SECRET=

# E-mail (verificatie / wachtwoord reset) via Postmark
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=info@stiekemefotos.nl
