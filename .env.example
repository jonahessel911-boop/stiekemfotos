# xAI Grok — https://console.x.ai — never commit real keys
# Dezelfde key voor tekst én foto’s; geen aparte vision-key.
# Primaire key; alternatieven: GROK_API_KEY of XAI_KEY (zelfde waarde mag overal)
XAI_API_KEY=
# GROK_API_KEY=

# Chat-model zonder foto (zie “Models” in de console voor jouw account)
# XAI_MODEL=grok-3-latest

# Verplicht voor foto’s in de chat: een model dat image input ondersteunt.
# Exacte naam in console (veel accounts: grok-4 of grok-4.3).
# XAI_VISION_MODEL=grok-4

# Sessies voor inloggen (min. 16 tekens in productie)
# SESSION_SECRET=

# Optional: TTS voice id (default eve — jong/energiek; ara/sal ook mogelijk)
# XAI_TTS_VOICE=eve

# Z-Image Turbo API key (server-side only, never expose client-side).
ZMODEL_API_KEY=
# Optional API base override (default: https://zimageturbo.ai)
# ZMODEL_BASE_URL=https://zimageturbo.ai

# Optional: protect AI settings page (leave empty to disable in dev)
INSTELLINGEN_PIN=

# Supabase (profiles + persistent blob storage)
# Service role gives full server-side access (preferred for backend).
# If you only want profile reads in dev, anon key also works.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for protected engagement cron endpoint:
# Vercel cron should call /api/internal/engagement/dispatch with:
# Authorization: Bearer <ENGAGEMENT_CRON_SECRET>
ENGAGEMENT_CRON_SECRET=

# E-mail (verificatie / wachtwoord reset) via Postmark
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=info@discreetemeisjes.nl
